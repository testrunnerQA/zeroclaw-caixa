# config/config.toml.example
# Copy this file to config.toml and configure your local settings.

[agent]
name = "caixa"
description = "A ZeroClaw payment terminal assistant that parses table charge requests and monitors Solana Pay invoices."
model = "llama-3.3-70b-versatile"
temperature = 0.2

[secrets]
# Set secrets via environment variables in production, or configure them here for local testing.
# NEVER commit config.toml with active keys to Git.
HELIUS_API_KEY = "YOUR_HELIUS_RPC_API_KEY"
TWILIO_ACCOUNT_SID = "YOUR_TWILIO_ACCOUNT_SID"
TWILIO_AUTH_TOKEN = "YOUR_TWILIO_AUTH_TOKEN"
TWILIO_WHATSAPP_FROM = "whatsapp:+14155238886"

[channels.whatsapp.caixa]
phone_number_id = "14155238886"
access_token = "YOUR_TWILIO_ACCESS_TOKEN"
verify_token = "zeroclaw_verify_2024"

[channels.merchant_alerts.default]
type = "webhook"
listen_port = 8081
path = "/alerts"

[memory]
backend = "sqlite"
search_mode = "bm25"
