# Caixa — Environment Variables Template (safe to commit)
# Copy this file to .env and fill in your real values

# Groq LLM API Key (get from console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Helius RPC (Solana mainnet) — get from helius.dev
HELIUS_API_KEY=your_helius_api_key_here

# Twilio WhatsApp Sandbox — get from console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Your Solana wallet public key (receives USDC payments)
MERCHANT_WALLET=your_solana_wallet_address_here

# Public URL of your server — set this in production (e.g. https://yourserver.com)
# Leave blank for local dev — ngrok URL is auto-detected
# PUBLIC_URL=https://your-server.com
