# Git ignore file for Caixa — ZeroClaw Solana Pay agent

# ⚠️  NEVER commit these files — contain real API keys and secrets
config/agent.toml
config/config.toml
config/.secret_key

# ZeroClaw runtime data — agent memory, sessions, state
config/data/
config/state/
data/
*.db
*.db-shm
*.db-wal
*.jsonl
*.tmp.*

# Schema generated at runtime
schema.json

# Compiled artifacts
target/
*.wasm

# Rust build artifacts
**/*.rs.bk

# Editor files
.DS_Store
.vscode/
.idea/
*.swp

# Environment files — NEVER commit real .env
.env
.env.local

# ZeroClaw runtime directories
zeroclaw/
zeroclaw-release/

# Logs
logs/
*.log
